// src/main.ino
// External LED Blink Example
// Connect an LED with a 220Ω resistor to pin 13 (or any other pin)

const int LED_PIN = 13;  // Pin connected to the external LED

void setup() {
  // Initialize the digital pin as an output
  pinMode(LED_PIN, OUTPUT);
}

void loop() {
  // Turn the LED on
  digitalWrite(LED_PIN, HIGH);
  delay(1000);  // Wait for 1 second
  
  // Turn the LED off
  digitalWrite(LED_PIN, LOW);
  delay(1000);  // Wait for 1 second
}
